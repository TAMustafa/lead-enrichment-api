# Development only. Production: inject from your platform secret manager; never commit .env.
LQ_DATABASE_URL=postgresql://lead:lead@localhost:5432/leads
LQ_API_KEYS={"grid":"replace-with-a-random-secret-of-at-least-32-characters"}
LQ_FINGERPRINT_KEY=replace-with-a-stable-random-secret-at-least-32-characters
LQ_PLACES_PROVIDER=serpapi
LQ_SERPAPI_API_KEY=replace-me
LQ_SERPAPI_COUNTRY=nl
# Required only when LQ_PLACES_PROVIDER=google:
LQ_GOOGLE_API_KEY=
LQ_SALESFORCE_URL=https://your-domain.my.salesforce.com
LQ_SALESFORCE_VERSION=v67.0
LQ_SALESFORCE_CLIENT_ID=replace-me
LQ_SALESFORCE_CLIENT_SECRET=replace-me
LQ_BIGQUERY_PROJECT=your-project
LQ_BIGQUERY_TABLE=your-project.partners.existing_partners
LQ_PERSISTENCE_ENABLED=false
LQ_ROUTE=Lead
LQ_MAPPING_PATH=salesforce-mapping.json
LQ_ALLOW_GOOGLE_CRM_STORAGE=false
LQ_ALLOW_SERPAPI_CRM_STORAGE=false
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json
# Prefer workload identity / application default credentials over downloaded key files.
# LQ_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Exact Dutch BAG unit-use check; incomplete/foreign addresses require review when enabled.
LQ_RESIDENTIAL_CHECK_ENABLED=false

# Local demo only: Salesforce CLI alias for a non-production development org.
# LQ_DEMO_SALESFORCE_ORG=your-dev-org-alias
